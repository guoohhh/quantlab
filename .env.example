# llm.provider: mock | openai | deepseek | openai_compatible | router
QUANTLAB_LLM_PROVIDER=auto
QUANTLAB_LLM_MODEL=
QUANTLAB_LLM_BASE_URL=
QUANTLAB_OPENAI_MODEL=gpt-5.6-terra
QUANTLAB_OPENAI_REASONING_EFFORT=medium
QUANTLAB_DEEPSEEK_MODEL=deepseek-chat
QUANTLAB_OPENAI_ENABLED=true
QUANTLAB_DEEPSEEK_ENABLED=true
QUANTLAB_OPENAI_BASE_URL=https://code-plan.site/v1
QUANTLAB_DEEPSEEK_BASE_URL=https://api.deepseek.com
QUANTLAB_LOCAL_MODEL=
QUANTLAB_LOCAL_BASE_URL=
QUANTLAB_LOCAL_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional comma/semicolon separated key pools. When present, they take precedence.
OPENAI_API_KEYS=
DEEPSEEK_API_KEYS=

# Optional: absolute path to Node >=18. When omitted, PATH is used.
QUANTLAB_NODE_EXECUTABLE=node

# Never commit real keys.
# QuantLab loads this file automatically. Process-level environment variables take precedence.
# Optional: when set, every /api/ request must include X-QuantLab-Token.
QUANTLAB_API_TOKEN=
