# llm.provider: mock | openai | deepseek | openai_compatible | router
QUANTLAB_LLM_PROVIDER=deepseek
QUANTLAB_LLM_MODEL=
QUANTLAB_LLM_BASE_URL=
QUANTLAB_OPENAI_MODEL=gpt-5.6-terra
QUANTLAB_OPENAI_REASONING_EFFORT=medium
QUANTLAB_DEEPSEEK_MODEL=deepseek-chat
QUANTLAB_OPENAI_ENABLED=false
QUANTLAB_DEEPSEEK_ENABLED=true
# Leave empty to use the official OpenAI endpoint. Only set a third-party compatible
# endpoint after confirming its API-key handling, data retention and privacy policy.
QUANTLAB_OPENAI_BASE_URL=
QUANTLAB_DEEPSEEK_BASE_URL=https://api.deepseek.com
QUANTLAB_LOCAL_MODEL=
QUANTLAB_LOCAL_BASE_URL=
QUANTLAB_LOCAL_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional comma/semicolon separated key pools. When present, they take precedence.
OPENAI_API_KEYS=
DEEPSEEK_API_KEYS=

# Optional: absolute path to Node >=18. When omitted, PATH is used.
QUANTLAB_NODE_EXECUTABLE=node

# Never commit real keys.
# QuantLab loads this file automatically. Process-level environment variables take precedence.
# Optional: when set, every /api/ request must include X-QuantLab-Token.
QUANTLAB_API_TOKEN=
QUANTLAB_DATABASE_PATH=data/quantlab.db
QUANTLAB_DATA_DIR=data

# Optional notification credentials. Channels remain disabled until configured through the API.
# The channel configuration stores only these environment-variable names, never the secret value.
QUANTLAB_EMAIL_PASSWORD=
QUANTLAB_FEISHU_WEBHOOK=

# Free-source trusted-data refresh is server-observed/unverified_no_sla and fails closed.
QUANTLAB_TRUSTED_DATA_AUTO_REFRESH=true
